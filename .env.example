# Where detector state, alerts and observations are written.
#
# Optional: with nothing set the scan runs in memory and forgets itself on
# exit, which is fine for a look and wrong for anything left running.
#
# Any SQLAlchemy URL works. sqlite is enough for one machine:
#   LINKAGE_DATABASE_URL=sqlite:///linkage.db
#
# Postgres for anything hosted. Use the DIRECT (non -pooler) Neon endpoint:
# the pooler is a transaction pooler and the per-cycle state write is fine
# through it, but schema creation at startup is not.
LINKAGE_DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
