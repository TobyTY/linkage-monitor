# Where detector state, alerts and observations are written.
#
# Optional: with nothing set the scan runs in memory and forgets itself on
# exit, which is fine for a look and wrong for anything left running.
#
# Any SQLAlchemy URL works. sqlite is enough for one machine:
#   LINKAGE_DATABASE_URL=sqlite:///linkage.db
#
# Postgres for anything hosted. Use the DIRECT (non -pooler) Neon endpoint:
# the pooler is a transaction pooler and the per-cycle state write is fine
# through it, but schema creation at startup is not.
LINKAGE_DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Telegram delivery. Optional: without these, alerts print to the console only.
#
#   1. Message @BotFather on Telegram, send /newbot, follow the prompts.
#      It hands back a token that looks like 123456789:AAF...
#   2. Send your new bot any message (it cannot message you first).
#   3. Open https://api.telegram.org/bot<TOKEN>/getUpdates and read
#      result[0].message.chat.id -- that is your chat id.
#
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------------------
# ntfy -- no account anywhere, and the least setup of the three.
#
#   1. Install the ntfy app (Android, iOS) or open https://ntfy.sh in a browser.
#   2. Invent a topic name and subscribe to it in the app.
#   3. Paste the same name below.
#
# MAKE THE TOPIC LONG AND RANDOM. On the public server the topic IS the
# password: anyone who guesses it reads your alerts, and anyone who knows it
# can post to them. Generate one with:
#     python -c "import secrets; print('linkage-' + secrets.token_hex(8))"
# For anything that must stay private, self-host and set NTFY_SERVER.
NTFY_TOPIC=
NTFY_SERVER=

# ---------------------------------------------------------------------------
# Discord -- one URL, no bot registration, and it posts into a channel rather
# than a private chat, so more than one person can watch.
#
#   Server Settings -> Integrations -> Webhooks -> New Webhook -> Copy URL
#
# TREAT THIS URL AS A CREDENTIAL. Anyone holding it can post to that channel.
DISCORD_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Configure none, one, or all three. None is fine -- alerts go to the console.
# Check whatever you set with:
#     python -m linkage.scan --once --verify-alerts
