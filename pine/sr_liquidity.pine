//@version=6
// Support/Resistance and liquidity pools, defined mechanically.
//
// WHY THIS IS RULE-BASED AND NOT DRAWN BY HAND. A level you drew is a level you
// will defend. Every rule below is computable from OHLC alone, so the same bars
// always produce the same levels, and a level that stops working stops being
// drawn without anyone having to admit anything.
//
// STRUCTURE. A pivot high is a bar whose high exceeds the `len` bars either
// side of it; a pivot low is the mirror. That is a lagging definition -- a
// pivot is only confirmed `len` bars after it happened -- and the lag is the
// honest part. Anything that marks a pivot the moment it forms is using bars
// it did not have.
//
// Pivots within `merge x ATR` of each other are treated as one level: averaged
// together, with the touch count going up. Touch count IS the strength. A line
// price has turned away from four times is a different object from one it
// clipped once, and drawing them identically throws that away.
//
// LIQUIDITY IS A TIGHTER TEST THAN STRUCTURE, and keeping them apart is the
// point of this script. A level is ordinary support or resistance when the
// pivots that built it are merely NEAR each other. It is a liquidity pool only
// when they are at the SAME price -- the full spread of its pivots inside
// `equal x ATR`, which is a far tighter band than the merge tolerance. That is
// what an equal-high or equal-low cluster means, and it is where resting stop
// orders pool. Marked BSL above highs, SSL below lows.
//
// A pool price has closed through is SWEPT. Greyed rather than deleted: "this
// level was taken out on Tuesday" is information, and an empty chart is not.
//
// WHAT THIS DOES NOT DO. It does not predict. A level is a place where orders
// have historically rested, not a forecast that they still do. No signals, no
// arrows, no alert on a touch -- a touch is the start of a question.

indicator("S/R + Liquidity", overlay = true,
     max_lines_count = 500, max_boxes_count = 500, max_labels_count = 500)

// ─── Structure ───────────────────────────────────────────────────────────────
grpS       = "Structure"
pivotLen   = input.int(10, "Pivot lookback", minval = 2, maxval = 50, group = grpS, tooltip = "Bars either side a pivot must exceed. Higher = fewer, weightier levels, confirmed later.")
mergeMult  = input.float(0.5, "Merge levels within (xATR)", minval = 0.05, step = 0.05, group = grpS)
minTouch   = input.int(2, "Minimum touches to draw", minval = 1, group = grpS)
maxPerSide = input.int(6, "Max levels per side", minval = 1, maxval = 20, group = grpS)
maxDistPct = input.float(25.0, "Hide levels further than (% of price)", minval = 1.0, maxval = 100.0, step = 1.0, group = grpS, tooltip = "A pivot from a decade ago is still a real pivot and still worthless. On a long weekly history USDINR prints levels near 8 while it trades near 95. Percent rather than ATR so the bound means the same thing on an ETF and on a currency.")

// ─── Liquidity ───────────────────────────────────────────────────────────────
grpL      = "Liquidity"
eqMult    = input.float(0.12, "Equal high/low tolerance (xATR)", minval = 0.01, step = 0.01, group = grpL, tooltip = "Must stay well below the merge tolerance, or every level becomes a pool and the distinction is lost.")
showSwept = input.bool(true, "Keep swept pools (greyed)", group = grpL)

// ─── Appearance ──────────────────────────────────────────────────────────────
// ─── Sessions ────────────────────────────────────────────────────────────────
// Sessions are an INTRADAY idea. On a daily or weekly bar the whole session is
// inside one candle, so shading it colours the entire chart and says nothing.
// The script hides them above `sessMaxMin` rather than drawing something
// meaningless.
//
// Each session is declared in its OWN exchange timezone, not converted to
// yours. A session is defined by when its traders are at their desks, and that
// does not move when you do.
//
// Worth noting for this universe specifically: NSE closes 15:30 IST (10:00 UTC)
// and NYSE opens 09:30 ET (14:30 UTC). They never overlap -- not by a minute.
// That gap is exactly why every ADR linkage in config/universe.yaml carries an
// overnight move it cannot see, and why those pairs are observational.
grpSess    = "Sessions"
showSess   = input.bool(true, "Shade sessions", group = grpSess)
sessMaxMin = input.int(240, "Hide above this many minutes per bar", minval = 1, maxval = 1440, group = grpSess)
showOverlap = input.bool(true, "Highlight London/New York overlap", group = grpSess, tooltip = "The only window where two of the three largest FX centres are open together, and where most of the day's range usually prints.")

sydOn = input.bool(true,  "Sydney",    inline = "syd", group = grpSess)
sydS  = input.session("0700-1600", "", inline = "syd", group = grpSess)
tokOn = input.bool(true,  "Tokyo",     inline = "tok", group = grpSess)
tokS  = input.session("0900-1500", "", inline = "tok", group = grpSess)
indOn = input.bool(true,  "India NSE", inline = "ind", group = grpSess)
indS  = input.session("0915-1530", "", inline = "ind", group = grpSess)
lonOn = input.bool(true,  "London",    inline = "lon", group = grpSess)
lonS  = input.session("0800-1630", "", inline = "lon", group = grpSess)
nyOn  = input.bool(true,  "New York",  inline = "ny",  group = grpSess)
nyS   = input.session("0930-1600", "", inline = "ny", group = grpSess)

sydCol = input.color(color.new(#8b949e, 88), "Sydney",   inline = "sc", group = grpSess)
tokCol = input.color(color.new(#a371f7, 88), "Tokyo",    inline = "sc", group = grpSess)
indCol = input.color(color.new(#f778ba, 88), "India",    inline = "sc2", group = grpSess)
lonCol = input.color(color.new(#58a6ff, 88), "London",   inline = "sc2", group = grpSess)
nyCol  = input.color(color.new(#3fb950, 88), "New York", inline = "sc3", group = grpSess)
ovCol  = input.color(color.new(#d29922, 80), "Overlap",  inline = "sc3", group = grpSess)

grpA       = "Appearance"
resCol     = input.color(color.new(#f85149, 0),  "Resistance", group = grpA)
supCol     = input.color(color.new(#3fb950, 0),  "Support",    group = grpA)
liqCol     = input.color(color.new(#d29922, 0),  "Liquidity",  group = grpA)
sweptCol   = input.color(color.new(#8b909c, 40), "Swept",      group = grpA)
showLabels = input.bool(true, "Show labels", group = grpA)

atr = ta.atr(14)

ph = ta.pivothigh(high, pivotLen, pivotLen)
pl = ta.pivotlow(low,  pivotLen, pivotLen)

// Each level carries the running mean, the touch count, the bar it started on,
// and the min/max of the pivots that built it. The spread is what separates a
// liquidity pool from ordinary structure, so it has to be tracked, not inferred.
var array<float> resPx  = array.new_float()
var array<int>   resN   = array.new_int()
var array<int>   resBar = array.new_int()
var array<float> resLo  = array.new_float()
var array<float> resHi  = array.new_float()

var array<float> supPx  = array.new_float()
var array<int>   supN   = array.new_int()
var array<int>   supBar = array.new_int()
var array<float> supLo  = array.new_float()
var array<float> supHi  = array.new_float()

absorb(array<float> px, array<int> n, array<int> bars, array<float> lo, array<float> hi,
       float p, int bi, float tol) =>
    idx  = -1
    size = array.size(px)
    if size > 0
        for i = 0 to size - 1
            if math.abs(array.get(px, i) - p) <= tol
                idx := i
                break
    if idx >= 0
        t   = array.get(n, idx) + 1
        old = array.get(px, idx)
        array.set(px, idx, old + (p - old) / t)   // running mean
        array.set(n, idx, t)
        array.set(bars, idx, bi)
        array.set(lo, idx, math.min(array.get(lo, idx), p))
        array.set(hi, idx, math.max(array.get(hi, idx), p))
    else
        array.push(px, p)
        array.push(n, 1)
        array.push(bars, bi)
        array.push(lo, p)
        array.push(hi, p)

if not na(ph)
    absorb(resPx, resN, resBar, resLo, resHi, ph, bar_index - pivotLen, atr * mergeMult)
if not na(pl)
    absorb(supPx, supN, supBar, supLo, supHi, pl, bar_index - pivotLen, atr * mergeMult)

var array<line>  drawnLines  = array.new_line()
var array<label> drawnLabels = array.new_label()

clearDrawings() =>
    if array.size(drawnLines) > 0
        for i = 0 to array.size(drawnLines) - 1
            line.delete(array.get(drawnLines, i))
    if array.size(drawnLabels) > 0
        for i = 0 to array.size(drawnLabels) - 1
            label.delete(array.get(drawnLabels, i))
    array.clear(drawnLines)
    array.clear(drawnLabels)

// Strongest first, so `maxPerSide` keeps the levels price respected most rather
// than the ones that happen to be most recent.
//
// The distance test lives HERE rather than at draw time, and that ordering is
// the whole point. Rank first and filter after, and a handful of ancient
// high-touch levels take every slot and are then thrown away, leaving a chart
// with nothing on it. Excluding them from selection means the six slots go to
// the six best levels that are actually near price.
rank(array<int> n, array<float> px, int want) =>
    order = array.new_int()
    used  = array.new_bool(array.size(n), false)
    limit = close * maxDistPct / 100.0
    count = math.min(want, array.size(n))
    if count > 0
        for _ = 1 to count
            best  = -1
            bestN = -1
            for i = 0 to array.size(n) - 1
                near = math.abs(array.get(px, i) - close) <= limit
                if not array.get(used, i) and near and array.get(n, i) > bestN
                    bestN := array.get(n, i)
                    best  := i
            if best >= 0
                array.set(used, best, true)
                array.push(order, best)
    order

drawSide(array<float> px, array<int> n, array<int> bars, array<float> lo, array<float> hi,
         color col, bool isRes) =>
    order = rank(n, px, maxPerSide)
    if array.size(order) > 0
        for k = 0 to array.size(order) - 1
            i = array.get(order, k)
            t = array.get(n, i)
            if t >= minTouch
                p      = array.get(px, i)
                spread = array.get(hi, i) - array.get(lo, i)
                isPool = t >= 2 and spread <= atr * eqMult
                swept  = isRes ? close > p : close < p
                shade  = swept ? sweptCol : (isPool ? liqCol : col)
                if not swept or showSwept
                    ln = line.new(array.get(bars, i), p, bar_index + 10, p,
                         xloc  = xloc.bar_index,
                         color = shade,
                         style = swept ? line.style_dotted : line.style_solid,
                         width = t >= 4 ? 2 : 1)
                    array.push(drawnLines, ln)
                    if showLabels
                        tag = swept ? "swept" : isPool ? (isRes ? "BSL" : "SSL") : str.tostring(t) + "x"
                        lb = label.new(bar_index + 10, p, tag,
                             xloc      = xloc.bar_index,
                             style     = label.style_label_left,
                             color     = color.new(color.black, 100),
                             textcolor = shade,
                             size      = size.tiny)
                        array.push(drawnLabels, lb)

// A session is "on" when time() returns non-na for that session string in that
// session's own timezone.
inSess(string sess, string tz) =>
    not na(time(timeframe.period, sess, tz))

sessOK = showSess and timeframe.isintraday and timeframe.in_seconds() <= sessMaxMin * 60

inSyd = sessOK and sydOn and inSess(sydS, "Australia/Sydney")
inTok = sessOK and tokOn and inSess(tokS, "Asia/Tokyo")
inInd = sessOK and indOn and inSess(indS, "Asia/Kolkata")
inLon = sessOK and lonOn and inSess(lonS, "Europe/London")
inNy  = sessOK and nyOn  and inSess(nyS,  "America/New_York")
inOv  = sessOK and showOverlap and inLon and inNy

// Painted least-important first so the overlap sits on top of both its parents.
bgcolor(inSyd ? sydCol : na, title = "Sydney session")
bgcolor(inTok ? tokCol : na, title = "Tokyo session")
bgcolor(inInd ? indCol : na, title = "India session")
bgcolor(inLon ? lonCol : na, title = "London session")
bgcolor(inNy  ? nyCol  : na, title = "New York session")
bgcolor(inOv  ? ovCol  : na, title = "London/NY overlap")

if barstate.islast
    clearDrawings()
    drawSide(resPx, resN, resBar, resLo, resHi, resCol, true)
    drawSide(supPx, supN, supBar, supLo, supHi, supCol, false)
